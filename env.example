# 牛马 nmer — 环境变量示例（勿填入真实值；复制后仅用于本机，不要提交 Git）
#
# 真实配置优先级：
#   1. local/ 目录（user_studio.json、niuma_chat_llm.json 等，已被 .gitignore 排除）
#   2. 系统用户目录（如 %LOCALAPPDATA%\hermes\.env、OpenClaw 本机状态）
#   3. 本文件复制为 .env 仅作本地开发参考（.env 默认被 Git 忽略）
#
# 详见：docs/wails-migration-boundary.md

# OpenClaw Gateway（本机默认 127.0.0.1:18789）
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_STATE_DIR=

# Hermes API Server（本机默认 8642/v1）
HERMES_API_SERVER_KEY=
HERMES_BASE_URL=http://127.0.0.1:8642/v1

# 牛马用户私有配置目录（默认指向仓库内 local/，每台机器独立）
NIUMA_LOCAL_CONFIG_DIR=

# Wails TPA sidecar 监听地址（B2，默认 127.0.0.1:18791）
NMER_A2UI_BRIDGE_ADDR=

# 功能开关见 local/nmer-flags.json（不进 Git），模板：docs/nmer-flags.example.json
# 灰度规则：officialA2ui.enabled=true 且命令以白名单 slash 开头 → R3；否则 R1+R2（OpenClaw）
# rollback.forceNmerOnly=true 时强制 R1+R2（优先于 official.enabled）
