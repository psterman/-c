# 本地/敏感：SQLite 主库与 WAL（勿提交；剪贴板内容易含 Token/API Key）
*.db
*.db-shm
*.db-wal

# 根目录 FTS5 剪贴板库（modules/ClipboardFTS5.ahk 使用）
/Clipboard.db
/Clipboard.db-shm
/Clipboard.db-wal

# 显式命名（与通配重复亦可，便于阅读）
Clipboard.db
CursorData.db
CursorHelper.db

# 用户数据目录（含 CursorData.db、截图缓存等）
Data/*
!Data/.gitkeep

# 本地配置（每人不同，不宜进仓库）
CursorShortcut.ini
PromptTemplates.ini

# 用户定制（含 API Key）
config/user_studio.json
config/user_studio.backup.json
config/niuma_chat_llm.json
config/curser.ini

# 备份与临时
*.bak*
temp_*
_ftb_tmp_check.js
*.lnk

# 调试日志（根目录）
clipboard_debug.log
NiumaTtyd_debug.log
Run History.csv
ttyd_repair.log

# 运行时 Cache（保留 .gitkeep 占位）
Cache/*
!Cache/.gitkeep
Cache/openclaw-state/

cache/dict_install/

# Whisper STT：本地 venv 与模型（运行 tools/whisper-stt/setup-whisper.ps1 生成，勿提交）
tools/whisper-stt/.venv/
tools/whisper-stt/models/
tools/whisper-stt/output.txt
tools/whisper-stt/__pycache__/

# Prototype: generated artifacts and local deps（已迁至 archive/prototype/）
archive/prototype/**/frontend/node_modules/
archive/prototype/**/frontend/dist/
archive/prototype/**/build/bin/
archive/prototype/**/.wails/
archive/prototype/**/*.log
archive/prototype/**/tmp/
archive/prototype/**/temp/

# 根目录依赖
/node_modules/

# 诊断输出
tools/drop-diagnostics/results/
tools/search-diagnostics/results/

# IDE
.cursor/
