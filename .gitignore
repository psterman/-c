# 本地/敏感：SQLite 主库与 WAL（勿提交；剪贴板内容易含 Token/API Key）
*.db
*.db-shm
*.db-wal

# 根目录 FTS5 剪贴板库（modules/ClipboardFTS5.ahk 使用）
/Clipboard.db
/Clipboard.db-shm
/Clipboard.db-wal

# 显式命名（与通配重复亦可，便于阅读）
Clipboard.db
CursorData.db
CursorHelper.db

# 用户数据目录（含 CursorData.db、截图缓存等）
Data/

# 本地配置（每人不同，不宜进仓库）
CursorShortcut.ini
PromptTemplates.ini

# 调试日志（根目录）
clipboard_debug.log

# 运行时 Cache（AHK/桥接进程常占用，勿提交）
Cache/*.log
Cache/*.jsonl
Cache/ahk_stderr.txt
Cache/validate_out.txt
Cache/validate_out.txt.err
Cache/bisect_mini.log
Cache/probe_empty.log
Cache/hole-vite.log

cache/dict_install/

# Whisper STT：本地 venv 与模型（运行 tools/whisper-stt/setup-whisper.ps1 生成，勿提交）
tools/whisper-stt/.venv/
tools/whisper-stt/models/
tools/whisper-stt/output.txt
tools/whisper-stt/__pycache__/

# Prototype: generated artifacts and local deps
prototype/**/frontend/node_modules/
prototype/**/frontend/dist/
prototype/**/build/bin/
prototype/**/.wails/
prototype/**/*.log
prototype/**/tmp/
prototype/**/temp/
